+/*
+ * spdkhost: LZ_CMD_DUP_APPEND (0xB0) -- the native dedup append.
+ * cdw10 = nlb-1 (nlb must be 1: the primitive is page-granular); the
+ * controller hashes the payload, routes it (C1), appends to the chosen
+ * zone, and runs the dedup decision.  cdw0 of the completion carries
+ * the assigned LBA.
+ */
+static uint16_t zns_dup_append(FemuCtrl *n, NvmeNamespace *ns, NvmeCmd *cmd,
+                               NvmeRequest *req)
+{
+    NvmeRwCmd *rw = (NvmeRwCmd *)&req->cmd;
+    uint32_t npages = le32_to_cpu(cmd->cdw10) + 1;   /* 4 KiB pages */
+    uint32_t spp = 4096 / n->zns->lbasz;             /* LBAs per page */
+    uint32_t nlb = npages * spp;                     /* in 512 B LBAs */
+    uint64_t data_size = (uint64_t)npages * 4096;
+    uint64_t data_offset;
+    NvmeZone *zone;
+    NvmeZonedResult *res = (NvmeZonedResult *)&req->cqe;
+    uint32_t lsh, zone_idx;
+    uint16_t status;
+
+    if (!lz_is_enabled(n)) {
+        return NVME_INVALID_OPCODE | NVME_DNR;
+    }
+    if (npages != 1) {
+        return NVME_INVALID_FIELD | NVME_DNR;   /* page-granular primitive */
+    }
+
+    status = nvme_check_mdts(n, data_size);
+    if (status) {
+        return status | NVME_DNR;
+    }
+
+    /* map the payload once; the hash reads it through the qsg */
+    status = zns_map_dptr(n, data_size, req);
+    if (status) {
+        return status | NVME_DNR;
+    }
+
+    lsh = lz_route_digest(n, req);
+    zone_idx = lz_pick_zone(n, lsh);
+    if (zone_idx >= n->num_zones) {
+        return NVME_ZONE_FULL | NVME_DNR;
+    }
+    zone = &n->zone_array[zone_idx];
+
+    /* never route into a reset-pending zone */
+    if (lz_zone_is_pending(n, zone_idx)) {
+        lz_note_append_rejected(n);
+        return NVME_ZONE_READ_ONLY | NVME_DNR;
+    }
+
+    /* zone state + zasl checks, mirroring zns_check_zone_write(append) */
+    status = zns_check_zone_state_for_write(zone);
+    if (status) {
+        return status | NVME_DNR;
+    }
+    if (data_size > ((uint64_t)n->page_size << n->zasl)) {
+        return NVME_INVALID_FIELD | NVME_DNR;
+    }
+    if (zone->w_ptr + nlb > zns_zone_wr_boundary(zone)) {
+        return NVME_ZONE_BOUNDARY_ERROR | NVME_DNR;
+    }
+
+    /* zns_finalize_zoned_write locates the zone via the command's slba
+     * and advances the host-visible WP from its nlb: rewrite both to
+     * the device-picked zone (the host sent neither for a 0xB0).      */
+    rw->slba = zone->d.zslba;
+    rw->nlb = cpu_to_le16(nlb - 1);
+
+    status = zns_auto_open_zone(ns, zone);
+    if (status) {
+        return status | NVME_DNR;
+    }
+
+    req->is_write = 1;
+    req->nlb = nlb;
+    req->slba = zone->w_ptr;                 /* the assigned LBA */
+    res->slba = zns_advance_zone_wp(ns, zone, nlb);
+
+    /* dedup decision FIRST: it reads the payload through the qsg, and
+     * backend_rw destroys the sglist when it copies the data           */
+    req->lz_md_lat_ns = lz_decide_write(n, req, zone_idx);
+
+    /* data lands in the memory backend: reads stay correct even for
+     * descriptor-backed slots; the NAND program is suppressed later in
+     * the FTL thread when req->lz_hit is set.                              */
+    data_offset = zns_l2b(ns, req->slba);
+    backend_rw(n->mbe, &req->qsg, &data_offset, req->is_write);
+    zns_finalize_zoned_write(ns, req, false);
+    n->zns->active_zone = zone_idx;
+
+    lz_note_dup_append(n);
+    return NVME_SUCCESS;
+}
+
+/* spdkhost: LZ_CMD_STATS (0xB1) -- optional dptr receives the blob */
+static uint16_t zns_stats_cmd(FemuCtrl *n, NvmeRequest *req)
+{
+    NvmeCmd *cmd = (NvmeCmd *)&req->cmd;
+    uint64_t prp1 = le64_to_cpu(cmd->dptr.prp1);
+    uint64_t prp2 = le64_to_cpu(cmd->dptr.prp2);
+    LZStatsBlob blob;
+
+    lz_stats_blob(n, &blob);
+    lz_dump_stats(n);
+    if (prp1) {
+        dma_read_prp(n, (uint8_t *)&blob, sizeof(blob), prp1, prp2);
+    }
+    return NVME_SUCCESS;
+}
+
+/* spdkhost: LZ_CMD_ZONE_QUERY (0xB2) -- cdw10 = zid */
+static uint16_t zns_zone_query_cmd(FemuCtrl *n, NvmeRequest *req)
+{
+    NvmeCmd *cmd = (NvmeCmd *)&req->cmd;
+    uint64_t prp1 = le64_to_cpu(cmd->dptr.prp1);
+    uint64_t prp2 = le64_to_cpu(cmd->dptr.prp2);
+    uint32_t zid = le32_to_cpu(cmd->cdw10);
+    LZZoneInfo info;
+
+    if (!prp1 || zid >= n->num_zones) {
+        return NVME_INVALID_FIELD | NVME_DNR;
+    }
+    if (lz_zone_query(n, zid, &info) != 0) {
+        return NVME_INVALID_FIELD | NVME_DNR;
+    }
+    dma_read_prp(n, (uint8_t *)&info, sizeof(info), prp1, prp2);
+    return NVME_SUCCESS;
+}
